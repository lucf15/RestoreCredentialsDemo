<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- The local session is deliberately not backed up: restore-on-a-new-device is what the -->
    <!-- restore credential itself is for, not generic file backup carrying an auth token along. -->
    <exclude domain="file" path="datastore/session.preferences_pb" />
</full-backup-content>