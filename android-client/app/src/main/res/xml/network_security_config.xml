<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks plain HTTP by default since API 28. This scopes a cleartext exception to just the
  emulator's host-machine alias, for talking to `./gradlew run` on localhost during development -
  it does not apply to any other domain, including the real RP_ORIGIN used for restore credentials.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
