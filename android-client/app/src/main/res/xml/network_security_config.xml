<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks plain HTTP by default since API 28. This scopes a cleartext exception to localhost
  only, for talking to `./gradlew run` over `adb reverse` during development. It does not apply to
  any other domain, including the real RP_ORIGIN used for restore credentials.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
